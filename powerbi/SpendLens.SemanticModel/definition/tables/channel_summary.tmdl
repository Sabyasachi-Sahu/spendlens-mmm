table channel_summary
	lineageTag: 035332e8-0dc7-4542-bfaa-8bc13302a412

	measure 'Paid Spend' =
			
			CALCULATE ( SUM ( channel_summary[spend_mean] ), channel_summary[channel] <> "All Channels" )
		formatString: 0
		lineageTag: b611a39f-4fd7-4902-9eba-fddc0cf73e59

	measure 'Incremental Outcome' =
			
			CALCULATE ( SUM ( channel_summary[incremental_outcome_mean] ), channel_summary[channel] <> "All Channels" )
		formatString: 0
		lineageTag: f8583a55-4e38-4ef3-8e10-b28181d57cf2

	measure ROI = DIVIDE ( [Incremental Outcome], [Paid Spend] )
		lineageTag: 48b23f8a-30a2-48d5-a070-4e26c60a149b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure mROI =
			
			IF (
			    HASONEVALUE ( dim_channel[channel] ),
			    CALCULATE ( SUM ( channel_summary[mroi_mean] ), channel_summary[channel] <> "All Channels" ),
			    BLANK ()
			)
		lineageTag: 88135d99-fc7f-453e-b651-0eef4ab24d56

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total ROI (all channels)' =
			
			CALCULATE (
			    MAX ( channel_summary[roi_mean] ),
			    channel_summary[channel] = "All Channels",
			    REMOVEFILTERS ( dim_channel )
			)
		lineageTag: ccef0de5-d5be-4841-b2b1-b14d7b58c49c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Media Contribution %' =
			
			DIVIDE (
			    CALCULATE (
			        MAX ( channel_summary[pct_of_contribution_mean] ),
			        channel_summary[channel] = "All Channels",
			        REMOVEFILTERS ( dim_channel )
			    ),
			    100
			)
		lineageTag: dd6831da-8d37-49f1-a68c-e5be85c3f6be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

