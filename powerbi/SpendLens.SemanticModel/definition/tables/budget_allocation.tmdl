table budget_allocation
	lineageTag: f990ea5b-9670-4ef1-8e69-b507fa6e624e

	measure 'Baseline Budget' =
			
			CALCULATE ( SUM ( budget_allocation[baseline_spend] ), budget_allocation[channel] <> "All Channels" )
		formatString: 0
		lineageTag: e7097c05-9284-44bd-8d39-ec06bc6909df

	measure 'Optimized Budget' =
			
			CALCULATE ( SUM ( budget_allocation[optimized_spend] ), budget_allocation[channel] <> "All Channels" )
		formatString: 0
		lineageTag: 1a9bd53a-9eb8-4d45-a575-ce1160d62151

	measure 'Budget Shift' =
			
			IF (
			    ISBLANK ( [Baseline Budget] ) && ISBLANK ( [Optimized Budget] ),
			    BLANK (),
			    [Optimized Budget] - [Baseline Budget]
			)
		formatString: 0
		lineageTag: 0115855b-eb8f-4be5-a1b0-36e9606bf22c

	measure 'Budget Change %' =
			
			IF (
			    ISBLANK ( [Baseline Budget] ),
			    BLANK (),
			    DIVIDE ( [Optimized Budget], [Baseline Budget] ) - 1
			)
		lineageTag: 06f4cf80-b5d7-48f0-9dc0-4e6ad9e4c357

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Baseline Outcome' =
			
			CALCULATE ( SUM ( budget_allocation[baseline_incremental_outcome] ), budget_allocation[channel] <> "All Channels" )
		formatString: 0
		lineageTag: 32129487-15a3-44a0-bcd3-8bec795eb2fb

	measure 'Optimized Outcome' =
			
			CALCULATE ( SUM ( budget_allocation[optimized_incremental_outcome] ), budget_allocation[channel] <> "All Channels" )
		formatString: 0
		lineageTag: 367a3ceb-b061-4b57-a979-5370150d0787

	measure 'Outcome Lift %' =
			
			IF (
			    ISBLANK ( [Baseline Outcome] ),
			    BLANK (),
			    DIVIDE ( [Optimized Outcome], [Baseline Outcome] ) - 1
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d271bbad-222b-4ba4-98bb-c8368ca44f7f

