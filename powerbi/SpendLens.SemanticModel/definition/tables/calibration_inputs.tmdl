		sourceColumn: lift_upper

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column roi_lower =
			
			DIVIDE (
			    calibration_inputs[lift_lower] * calibration_inputs[roi_point],
			    calibration_inputs[incremental_kpi]
			)
		formatString: 0.00
		lineageTag: 2438e34f-4c3a-480f-95d9-14b1bf8c6dd0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column roi_upper =
			
			DIVIDE (
			    calibration_inputs[lift_upper] * calibration_inputs[roi_point],
			    calibration_inputs[incremental_kpi]
			)
		formatString: 0.00
		lineageTag: 40ead6e2-51c9-4ba7-a7eb-f638aec86ffa
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

